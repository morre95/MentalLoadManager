# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-secret
JWT_EXPIRE_MINUTES=30

# Backend + frontend URLs used by OAuth callback redirects
# BACKEND_URL is optional. If empty, callback URLs are inferred from the incoming request host.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional hard override for Google callback URL (recommended in production)
# Must exactly match one Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Instagram OAuth
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mental_load

# OpenRouter (AI weekly summaries)
OPENROUTER_API_KEY=your-openrouter-api-key
# Free-model default via OpenRouter free router (stable when individual :free IDs change)
OPENROUTER_WEEKLY_SUMMARY_MODEL=openai/gpt-oss-120b:free
# Optional comma-separated fallback models used on rate limit
OPENROUTER_WEEKLY_SUMMARY_FALLBACK_MODELS=openrouter/free


SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
SESSION_SECRET=secret-string-here

# Settings for fastapi-mail
MAIL_USERNAME=username-here
MAIL_PASSWORD=password-here
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_FROM_NAME=Mental Load Manager
MAIL_STARTTLS=false
MAIL_SSL_TLS=talse
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true
CONTACT_RECIPIENT_EMAI="hello@mentalloadmanager.com"
